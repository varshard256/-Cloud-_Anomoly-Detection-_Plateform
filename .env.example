# Rename this file to .env and fill in real values before running

# Flask
FLASK_ENV=development
SECRET_KEY=change-this-to-a-long-random-string

# Database
# For quick local runs, SQLite is used automatically if DATABASE_URL is not set.
# For MySQL (recommended for submission/deployment), uncomment and edit:
# DATABASE_URL=mysql+pymysql://root:password@localhost:3306/neurocloud

# Mail (Flask-Mail) - used for password reset / alert emails
MAIL_SERVER=smtp.gmail.com
MAIL_PORT=587
MAIL_USE_TLS=True
MAIL_USERNAME=your-email@gmail.com
MAIL_PASSWORD=your-app-password
MAIL_DEFAULT_SENDER=your-email@gmail.com

# Admin bootstrap account (created by seed script)
ADMIN_EMAIL=admin@neurocloud.app
ADMIN_PASSWORD=Admin@12345
